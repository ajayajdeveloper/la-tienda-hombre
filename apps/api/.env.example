# Copy to .env for local development.
DATABASE_URL=postgres://hombre:hombre@localhost:5433/hombre
PORT=4000
# Browser origins allowed by CORS (comma-separated). In dev the Vite proxy makes
# requests same-origin, so this only matters if you call the API directly.
WEB_ORIGIN=http://localhost:5174
DB_POOL_MAX=10
# Number of proxies in front of the API (nginx = 1). Needed for correct client IPs.
TRUST_PROXY=0
